    - target: {fileID: 227909857412235546, guid: d1678d411b7e67f468596dd5279fdbee, type: 3}
      propertyPath: data.title
      value: "\u0E27\u0E31\u0E19\u0E17\u0E35\u0E48 ??/\u2014/\u2014"
      objectReference: {fileID: 0}
    - target: {fileID: 227909857412235546, guid: d1678d411b7e67f468596dd5279fdbee, type: 3}
      propertyPath: data.content
      value: " \u0E09\u0E31\u0E19\u0E23\u0E39\u0E49\u0E27\u0E48\u0E32\u0E21\u0E31\u0E19\u0E1C\u0E34\u0E14\u0E41\u0E25\u0E30\u0E23\u0E39\u0E49\u0E2A\u0E36\u0E01\u0E1C\u0E34\u0E14\u0E01\u0E31\u0E1A\u0E19\u0E32\u0E27\u0E34\u0E19\u0E21\u0E32\u0E01\u0E46 \u0E02\u0E2D\u0E42\u0E17\u0E29\u0E19\u0E30 \u0E41\u0E15\u0E48\u0E2A\u0E48\u0E27\u0E19\u0E2B\u0E19\u0E36\u0E07\u0E01\u0E47\u0E40\u0E1B\u0E47\u0E19\u0E04\u0E27\u0E32\u0E21\u0E1C\u0E34\u0E14\u0E02\u0E2D\u0E07\u0E19\u0E32\u0E22\u0E40\u0E2B\u0E21\u0E37\u0E2D\u0E19\u0E01\u0E31\u0E19\u0E17\u0E35\u0E48\u0E44\u0E21\u0E48\u0E0A\u0E48\u0E27\u0E22\u0E25\u0E39\u0E01\u0E2A\u0E32\u0E27\u0E02\u0E2D\u0E07\u0E09\u0E31\u0E19 \u0E1E\u0E27\u0E01\u0E40\u0E23\u0E32\u0E40\u0E1B\u0E47\u0E19\u0E40\u0E1E\u0E37\u0E48\u0E2D\u0E19\u0E01\u0E31\u0E19\u0E19\u0E30 \u0E17\u0E31\u0E49\u0E07\u0E46 \u0E17\u0E35\u0E48\u0E19\u0E32\u0E22\u0E23\u0E31\u0E1A\u0E1B\u0E32\u0E01\u0E27\u0E48\u0E32\u0E08\u0E30\u0E0A\u0E48\u0E27\u0E22\u0E09\u0E31\u0E19\u0E15\u0E2D\u0E19\u0E17\u0E35\u0E48\u0E25\u0E33\u0E1A\u0E32\u0E01 \u0E41\u0E15\u0E48\u0E19\u0E32\u0E22\u0E01\u0E25\u0E31\u0E1A\u0E1C\u0E34\u0E14\u0E04\u0E33\u0E1E\u0E39\u0E14\u0E41\u0E25\u0E30\u0E40\u0E21\u0E34\u0E19\u0E04\u0E33\u0E02\u0E2D\u0E02\u0E2D\u0E07\u0E09\u0E31\u0E19\r\n \u0E40\u0E21\u0E37\u0E48\u0E2D\u0E44\u0E21\u0E48\u0E01\u0E35\u0E48\u0E04\u0E37\u0E19\u0E01\u0E48\u0E2D\u0E19\u0E09\u0E31\u0E19\u0E44\u0E14\u0E49\u0E23\u0E31\u0E1A\u0E01\u0E32\u0E23\u0E15\u0E34\u0E14\u0E15\u0E48\u0E2D\u0E08\u0E32\u0E01\u0E04\u0E19\u0E17\u0E35\u0E48\u0E2D\u0E22\u0E39\u0E48\u0E19\u0E2D\u0E01\u0E2B\u0E21\u0E39\u0E48\u0E1A\u0E49\u0E32\u0E19 \u0E43\u0E2B\u0E49\u0E0A\u0E48\u0E27\u0E22\u0E40\u0E23\u0E37\u0E48\u0E2D\u0E07\u0E1A\u0E32\u0E07\u0E2D\u0E22\u0E48\u0E32\u0E07\u0E1E\u0E23\u0E49\u0E2D\u0E21\u0E01\u0E31\u0E1A\u0E40\u0E2A\u0E19\u0E2D\u0E04\u0E48\u0E32\u0E23\u0E31\u0E01\u0E29\u0E32\u0E43\u0E2B\u0E49\u0E01\u0E31\u0E1A\u0E25\u0E39\u0E01\u0E2A\u0E32\u0E27\u0E02\u0E2D\u0E07\u0E09\u0E31\u0E19\r\n\u0E02\u0E2D\u0E42\u0E17\u0E29\u0E19\u0E30 \u0E19\u0E32\u0E27\u0E34\u0E19 \u0E41\u0E15\u0E48\u0E17\u0E31\u0E49\u0E07\u0E2B\u0E21\u0E14\u0E19\u0E35\u0E49\u0E01\u0E47\u0E40\u0E1E\u0E37\u0E48\u0E2D\u0E25\u0E39\u0E01\u0E2A\u0E32\u0E27\u0E02\u0E2D\u0E07\u0E09\u0E31\u0E19"
