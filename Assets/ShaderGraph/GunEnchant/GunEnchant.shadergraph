{
    "m_SGVersion": 1,
    "m_Type": "UnityEditor.ShaderGraph.CustomFunctionNode",
    "m_ObjectId": "339ae6fc825d4ce8ba991fb51b4f322c",
    "m_Group": {
        "m_Id": ""
    },
    "m_Name": "GunEnchant (Custom Function)",
    "m_DrawState": {
        "m_Expanded": true,
        "m_Position": {
            "serializedVersion": "2",
            "x": -480,
            "y": 200,
            "width": 0.0,
            "height": 0.0
        }
    },
    "m_Slots": [
        {
            "m_Id": "1b66fc243db24643bca7a191f10e6ea5"
        },
        {
            "m_Id": "c188a313c80d4644984c770940953b22"
        },
        {
            "m_Id": "630cd6f802e447d9b9b69539b30202c9"
        },
        {
            "m_Id": "7ab13d4933174b08ad57d4e35ced54f0"
        },
        {
            "m_Id": "9962536070a5479fba3808e805a8f66b"
        },
        {
            "m_Id": "0a10135adb46405c8d71a0bac0f29045"
        },
        {
            "m_Id": "45b85b56cc5a4c30adff01fa5c7bdbeb"
        },
        {
            "m_Id": "dfb9375114ac482c9dee9de9e19cf9b1"
        },
        {
            "m_Id": "eb885eaeeb934ceb8cd13516ac866563"
        },
        {
            "m_Id": "983c364cb21140f9a0e1b5735d355cb6"
        },
        {
            "m_Id": "3245253958d947159dece5784ead4747"
        },
        {
            "m_Id": "baab5208d24048578db92fc16329f63b"
        },
        {
            "m_Id": "f13874248fd8449785af83866fd6fbf8"
        },
        {
            "m_Id": "8542218f4d4444b28ec5613e96faffde"
        },
        {
            "m_Id": "12f5c281247a4002bdedcd0dec120bb7"
        },
        {
            "m_Id": "12d7ad1e7a3641c594f7dc6ead9b47a4"
        }
    ],
    "synonyms": [],
    "m_Precision": 0,
    "m_PreviewExpanded": false,
    "m_DismissedVersion": 0,
    "m_PreviewMode": 0,
    "m_CustomColors": {
        "m_SerializableColors": []
    },
    "m_SourceType": 1,
    "m_FunctionName": "GunEnchant",
    "m_FunctionSource": "",
    "m_FunctionSourceUsePragmas": true,
    "m_FunctionBody": "// Gun Enchant: yantra veins flowing along the gun + charge pulse + fresnel rim + flicker\n// Additive overlay: black = invisible. Put it as an extra material on the gun mesh.\n#define GE_HASH(c) frac(sin(dot(cell + (c), float3(127.1, 311.7, 74.7))) * 43758.5453)\n\nfloat t = _TimeParameters.x;\nfloat3 axis = FlowAxis < 0.5 ? float3(1, 0, 0) : (FlowAxis < 1.5 ? float3(0, 1, 0) : float3(0, 0, 1));\nfloat along = dot(PositionOS, axis);\n\n// --- veins: ridged value-noise in object space, scrolling along the flow axis\nfloat3 q = PositionOS * VeinScale - axis * (t * FlowSpeed * 2.0);\nfloat n = 0.0;\nfloat amp = 0.55;\nfloat freq = 1.0;\n[unroll] for (int o = 0; o < 3; o++)\n{\n    float3 x = q * freq + o * 17.13;\n    float3 cell = floor(x);\n    float3 f = frac(x);\n    f = f * f * (3.0 - 2.0 * f);\n    float a = lerp(GE_HASH(float3(0, 0, 0)), GE_HASH(float3(1, 0, 0)), f.x);\n    float b = lerp(GE_HASH(float3(0, 1, 0)), GE_HASH(float3(1, 1, 0)), f.x);\n    float c = lerp(GE_HASH(float3(0, 0, 1)), GE_HASH(float3(1, 0, 1)), f.x);\n    float d = lerp(GE_HASH(float3(0, 1, 1)), GE_HASH(float3(1, 1, 1)), f.x);\n    n += lerp(lerp(a, b, f.y), lerp(c, d, f.y), f.z) * amp;\n    amp *= 0.5;\n    freq *= 2.03;\n}\nn /= 0.9625;                                   // 0.55 + 0.275 + 0.1375\nfloat ridge = 1.0 - abs(n * 2.0 - 1.0);        // thin lines where the noise crosses 0.5\nfloat width = max(VeinWidth * saturate(Enchant * 1.5), 0.0001);\nfloat veins = smoothstep(1.0 - width, 1.0, ridge);\n\n// --- charge pulse: bright bands travelling along the gun\nfloat wave = sin((along * VeinScale * 0.15 - t * PulseSpeed) * 6.2831853) * 0.5 + 0.5;\nfloat pulse = pow(wave, 6.0);\n\n// --- fresnel rim\nfloat facing = saturate(abs(dot(normalize(NormalWS), normalize(ViewDirWS))));\nfloat rim = pow(1.0 - facing, RimPower);\n\n// --- flicker (unstable magic)\nfloat flick = 1.0 + Flicker * (sin(t * 23.0) * 0.5 + sin(t * 37.7 + 1.3) * 0.35 + sin(t * 61.1) * 0.15);\n\nfloat3 edge = EdgeColor.rgb * (rim + veins * 0.7 + rim * pulse * 0.5);\nfloat3 core = CoreColor.rgb * veins * (0.25 + pulse * 1.5);\n\nOut = (edge + core) * Intensity * flick * saturate(Enchant);\nAlpha = 1.0;\n#undef GE_HASH"
}

