    "m_SourceType": 1,
    "m_FunctionName": "GunEnchantShell",
    "m_FunctionSource": "",
    "m_FunctionSourceUsePragmas": true,
    "m_FunctionBody": "// Push the surface out along its normal so the glow sits AROUND the gun, not on it\nOut = PositionOS + normalize(NormalOS) * AuraSize;"
}

