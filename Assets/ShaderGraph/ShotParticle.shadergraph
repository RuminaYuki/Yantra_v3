        },
        {
            "m_Id": "f1249a9c330f427e81e0413d8ee3e6f8"
        },
        {
            "m_Id": "ed7909cadcf64cc7b61f476a98742486"
        },
        {
            "m_Id": "1b8005d396b34fceb784328ecb524132"
        },
        {
            "m_Id": "a5c9c142b4eb45a985f40a825ccb7584"
        },
        {
            "m_Id": "76b4b8a01d2d40aba9c82e0fde0887bc"
        },
        {
            "m_Id": "80dfa363e5764df59b5cd44800b2d83d"
        },
        {
            "m_Id": "563283f6d99d4333ad15006ac6eb4aac"
        }
    ],
    "synonyms": [],
    "m_Precision": 0,
    "m_PreviewExpanded": false,
    "m_DismissedVersion": 0,
    "m_PreviewMode": 0,
    "m_CustomColors": {
        "m_SerializableColors": []
    },
    "m_SourceType": 1,
    "m_FunctionName": "ShotParticle",
    "m_FunctionSource": "",
    "m_FunctionSourceUsePragmas": true,
    "m_FunctionBody": "// Shape 0 = smoke puff (noise, erodes as the particle fades), 1 = glow dot (sparks / flash)\nfloat2 p = UV.xy * 2.0 - 1.0;\nfloat r = length(p);\n\nfloat n = 0.0;\nfloat amp = 0.5;\nfloat2 q = UV.xy * NoiseScale;\n[unroll] for (int o = 0; o < 3; o++)\n{\n    float2 i = floor(q);\n    float2 f = frac(q);\n    float2 u = f * f * (3.0 - 2.0 * f);\n    float a = frac(sin(dot(i, float2(127.1, 311.7))) * 43758.5453);\n    float b = frac(sin(dot(i + float2(1.0, 0.0), float2(127.1, 311.7))) * 43758.5453);\n    float c = frac(sin(dot(i + float2(0.0, 1.0), float2(127.1, 311.7))) * 43758.5453);\n    float d = frac(sin(dot(i + float2(1.0, 1.0), float2(127.1, 311.7))) * 43758.5453);\n    n += amp * lerp(lerp(a, b, u.x), lerp(c, d, u.x), u.y);\n    q *= 2.03;\n    amp *= 0.5;\n}\n\nfloat puff = 1.0 - smoothstep(Softness, 1.0, r + (0.5 - n) * 0.7);\nfloat erode = 1.0 - VertexColor.a;\nfloat smoke = puff * smoothstep(erode, erode + 0.45, n * 1.25 + (1.0 - r) * 0.3) * saturate(VertexColor.a * 3.0) * (0.75 + 0.5 * n);\nfloat glow = pow(saturate(1.0 - r), 2.2) * VertexColor.a;\nfloat shape = lerp(smoke, glow, Shape);\n\nfloat camFade = smoothstep(NearFade, max(FarFade, NearFade + 0.0001), length(PositionWS));\nOut = VertexColor.rgb * Tint.rgb;\nAlpha = saturate(shape * Tint.a * camFade);"
}

