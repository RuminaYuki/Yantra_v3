    "synonyms": [],
    "m_Precision": 0,
    "m_PreviewExpanded": false,
    "m_DismissedVersion": 0,
    "m_PreviewMode": 0,
    "m_CustomColors": {
        "m_SerializableColors": []
    },
    "m_SourceType": 1,
    "m_FunctionName": "ItemGlint",
    "m_FunctionSource": "",
    "m_FunctionSourceUsePragmas": true,
    "m_FunctionBody": "// RE4-style glint: a bright band sweeps diagonally across the item on screen, then pauses\nfloat3 offsetWS = PositionAWS - float3(CenterX, CenterY, CenterZ);\nfloat3 offsetVS = mul((float3x3)GetWorldToViewMatrix(), offsetWS) / max(Extent, 0.0001);\nfloat axis = dot(offsetVS.xy, float2(0.7071, 0.7071));\n\nfloat phase = frac(_TimeParameters.x / max(Period, 0.05) + Offset);\nfloat portion = max(SweepPortion, 0.05);\nfloat sweepPos = lerp(-1.4, 1.4, saturate(phase / portion));\nfloat band = (1.0 - smoothstep(0.0, Width, abs(axis - sweepPos))) * step(phase, portion);\n\nfloat facing = saturate(abs(dot(normalize(NormalWS), normalize(ViewDirWS))));\nfloat rim = pow(1.0 - facing, RimPower);\n\nOut = GlintColor.rgb * band + RimColor.rgb * rim;\nAlpha = 1.0;"
}

