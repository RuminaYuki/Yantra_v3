--- !u!1001 &3737426887897979458
PrefabInstance:
  m_ObjectHideFlags: 0
  serializedVersion: 2
  m_Modification:
    serializedVersion: 3
    m_TransformParent: {fileID: 1937956364128535175}
    m_Modifications:
    - target: {fileID: 227909857412235546, guid: d1678d411b7e67f468596dd5279fdbee, type: 3}
      propertyPath: data.title
      value: "Day 25/\u2014/\u2014"
      objectReference: {fileID: 0}
    - target: {fileID: 227909857412235546, guid: d1678d411b7e67f468596dd5279fdbee, type: 3}
      propertyPath: data.content
      value: "Couldn't find any food again today. Is heaven playing tricks on us? This is supposed to be the season when the fruit ripens, yet there's nothing. The food we stored is running out. And what do the villagers blame? Ghosts and forest spirits, of all things.\n    The elders can't think of anything else, even though it's plain to see. It was the flash flood two months ago that ruined almost the entire harvest.\n    So what now? Mother has fallen ill, and the hospital is so far away. If this goes on...\nWhat am I supposed to do..."
      objectReference: {fileID: 0}
    - target: {fileID: 1870692009784753091, guid: d1678d411b7e67f468596dd5279fdbee, type: 3}
