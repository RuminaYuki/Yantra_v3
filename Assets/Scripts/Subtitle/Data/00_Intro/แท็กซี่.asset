  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 75cd5e20844b4fa40bd192a329d6b5f0, type: 3}
  m_Name: "\u0E41\u0E17\u0E47\u0E01\u0E0B\u0E35\u0E48"
  m_EditorClassIdentifier: Assembly-CSharp::SubtitleDataSO
  Lines:
  - Speaker: {fileID: 11400000, guid: 56ca227c4d9e3824bb4a634e88a0d5c9, type: 2}
    TextKey: line_5b7947_01
    DefaultText: We're here... You sure this is the place? It's not even light out yet, nobody comes here this early. Want me to take you back to town?
    VoiceClip: {fileID: 8300000, guid: f0cbff056ad57c94faed410babfb9427, type: 3}
    FallbackDuration: 5
  - Speaker: {fileID: 11400000, guid: 9fb32e08e48d39f4f9d4bf3ae661839a, type: 2}
    TextKey: line_5b7947_02
    DefaultText: I'm fine, thanks. I came here on purpose.
    VoiceClip: {fileID: 8300000, guid: 262b5aaa2ae6ae54dbffd9d2f93bc1e3, type: 3}
    FallbackDuration: 3
  - Speaker: {fileID: 11400000, guid: 9fb32e08e48d39f4f9d4bf3ae661839a, type: 2}
    TextKey: line_5b7947_03
    DefaultText: Don't worry, I'm not here to do anything reckless... I just feel like I've been here before, so I wanted to find the truth.
    VoiceClip: {fileID: 8300000, guid: 2ae3c5b735b34fd428e490dd82cbbe3b, type: 3}
    FallbackDuration: 6
  - Speaker: {fileID: 11400000, guid: 56ca227c4d9e3824bb4a634e88a0d5c9, type: 2}
    TextKey: line_5b7947_04
    DefaultText: Alright, but if anything happens, that's not on me... Just putting it out there now, so you don't come back to haunt me.
    VoiceClip: {fileID: 8300000, guid: a1d053f3a8ca41f42be23136bd560180, type: 3}
    FallbackDuration: 5
  - Speaker: {fileID: 11400000, guid: 56ca227c4d9e3824bb4a634e88a0d5c9, type: 2}
    TextKey: line_5b7947_05
    DefaultText: Just kidding... But this place is the real deal, you know. Take care of yourself.
    VoiceClip: {fileID: 8300000, guid: d67366a9fcf0d7847b9a524b83b5e2bf, type: 3}
    FallbackDuration: 4
  - Speaker: {fileID: 11400000, guid: 9fb32e08e48d39f4f9d4bf3ae661839a, type: 2}
    TextKey: line_5b7947_06
    DefaultText: ......
    VoiceClip: {fileID: 8300000, guid: 34bdb3a24ad9ba44e87b4f75b8d79152, type: 3}
    FallbackDuration: 3
