  m_Script: {fileID: 11500000, guid: 75cd5e20844b4fa40bd192a329d6b5f0, type: 3}
  m_Name: Sub_Note_Bullets
  m_EditorClassIdentifier: Assembly-CSharp::SubtitleDataSO
  Lines:
  - Speaker: {fileID: 0}
    TextKey: note_bullets_01
    DefaultText: In the past, people would draw talismans on paper. The process was cumbersome and time-consuming, so they found a way around it by engraving special characters onto bullets instead. The enchantments engraved on these bullets only affect things imbued with magic. Against anything without magic, they are no different from ordinary bullets.
    VoiceClip: {fileID: 8300000, guid: 209c2fc87599a3644a4af62cd1f05ba4, type: 3}
    FallbackDuration: 0
  - Speaker: {fileID: 11400000, guid: 9fb32e08e48d39f4f9d4bf3ae661839a, type: 2}
    TextKey: note_bullets_02
    DefaultText: It only works on them. That's all I need.
    VoiceClip: {fileID: 0}
    FallbackDuration: 0
