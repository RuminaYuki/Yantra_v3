  m_Script: {fileID: 11500000, guid: 75cd5e20844b4fa40bd192a329d6b5f0, type: 3}
  m_Name: Sub_Note_Diary25
  m_EditorClassIdentifier: Assembly-CSharp::SubtitleDataSO
  Lines:
  - Speaker: {fileID: 0}
    TextKey: note_diary25_01
    DefaultText: "Day 25/\u2014/\u2014\nCouldn't find any food again today. Is heaven playing tricks on us? This is supposed to be the season when the fruit ripens, yet there's nothing. The food we stored is running out. And what do the villagers blame? Ghosts and forest spirits, of all things.\nThe elders can't think of anything else, even though it's plain to see. It was the flash flood two months ago that ruined almost the entire harvest.\nSo what now? Mother has fallen ill, and the hospital is so far away. If this goes on...\nWhat am I supposed to do..."
    VoiceClip: {fileID: 8300000, guid: 7fc170e3d310f494982abc9d792fa3c9, type: 3}
    FallbackDuration: 0
  - Speaker: {fileID: 11400000, guid: 9fb32e08e48d39f4f9d4bf3ae661839a, type: 2}
    TextKey: note_diary25_02
    DefaultText: I thought it was just a flash flood, nothing to do with ghosts... but in the end, ghosts are real.
    VoiceClip: {fileID: 0}
    FallbackDuration: 0
