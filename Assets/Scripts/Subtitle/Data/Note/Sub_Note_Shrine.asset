  Lines:
  - Speaker: {fileID: 0}
    TextKey: note_shrine_01
    DefaultText: Those who travel along this path often stop to pay their respects at this shrine. They believe doing so will ensure that nothing, or 'something', follows them home.
    VoiceClip: {fileID: 8300000, guid: 85b3727f557db3b4ba19d41b6fccb978, type: 3}
    FallbackDuration: 0
  - Speaker: {fileID: 11400000, guid: 9fb32e08e48d39f4f9d4bf3ae661839a, type: 2}
    TextKey: note_shrine_02
    DefaultText: Better pay my respects. Better safe than sorry.
    VoiceClip: {fileID: 0}
    FallbackDuration: 0
