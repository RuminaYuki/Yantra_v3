  m_Script: {fileID: 11500000, guid: 75cd5e20844b4fa40bd192a329d6b5f0, type: 3}
  m_Name: Sub_Note_Letter15.1
  m_EditorClassIdentifier: Assembly-CSharp::SubtitleDataSO
  Lines:
  - Speaker: {fileID: 0}
    TextKey: note_letter15_01
    DefaultText: "Date: 15/\u2013/\u2013\nIf anyone finds this note, I suppose you've made your way back here. Whatever your reason for coming, turn back. But if you're stubborn enough to keep going, then I can only pray that the sacred spirits protect you.\nYou don't have to believe me, but Navin told me to 'look for the 5 unusual trees wrapped in three-colored cloth and seal them.' Believe it or not, it's up to you. Anyone who comes here is bound to die sooner or later anyway.\nThat was everything I managed to learn from Navin before he disappeared."
    VoiceClip: {fileID: 8300000, guid: e200a9f711ef31341a3b398407352383, type: 3}
    FallbackDuration: 0
