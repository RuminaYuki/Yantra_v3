  m_Script: {fileID: 11500000, guid: 75cd5e20844b4fa40bd192a329d6b5f0, type: 3}
  m_Name: "\u0E41\u0E17\u0E47\u0E01\u0E0B\u0E35\u0E48"
  m_EditorClassIdentifier: Assembly-CSharp::SubtitleDataSO
  Lines:
  - Speaker: {fileID: 11400000, guid: 56ca227c4d9e3824bb4a634e88a0d5c9, type: 2}
    TextKey: 
    DefaultText: It's getting dark, kid. What are you doing around here? Want a ride into town? It's on me.
    VoiceClip: {fileID: 0}
    FallbackDuration: 3
  - Speaker: {fileID: 11400000, guid: 9fb32e08e48d39f4f9d4bf3ae661839a, type: 2}
    TextKey: 
    DefaultText: I'm fine, thanks. I came here on purpose.
    VoiceClip: {fileID: 0}
    FallbackDuration: 3
  - Speaker: {fileID: 11400000, guid: 9fb32e08e48d39f4f9d4bf3ae661839a, type: 2}
    TextKey: 
    DefaultText: Don't worry, I'm not here to do anything reckless... I just feel like I've been here before, so I wanted to find the truth.
    VoiceClip: {fileID: 0}
    FallbackDuration: 3
  - Speaker: {fileID: 11400000, guid: 56ca227c4d9e3824bb4a634e88a0d5c9, type: 2}
    TextKey: 
    DefaultText: Well, if anything happens, I'm not taking the blame...
    VoiceClip: {fileID: 0}
    FallbackDuration: 3
  - Speaker: {fileID: 11400000, guid: 56ca227c4d9e3824bb4a634e88a0d5c9, type: 2}
    TextKey: 
    DefaultText: Just kidding. But the ghosts around here are no joke, take care of yourself
    VoiceClip: {fileID: 0}
    FallbackDuration: 3
  - Speaker: {fileID: 11400000, guid: 9fb32e08e48d39f4f9d4bf3ae661839a, type: 2}
    TextKey: 
    DefaultText: ......
    VoiceClip: {fileID: 0}
    FallbackDuration: 3
