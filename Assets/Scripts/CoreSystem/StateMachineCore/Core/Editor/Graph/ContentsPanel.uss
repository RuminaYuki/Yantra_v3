/* Contents panel (ContentsPanel.cs). Colors are overlays, so they work on the dark and light editor skins. */

.contents {
    min-width: 0;
    overflow: hidden;
    padding: 4px 4px 0 4px;
}

/* ---------- Header: title and search ---------- */

.contents__header {
    flex-direction: row;
    align-items: center;
    margin-bottom: 4px;
}

.contents__title {
    -unity-font-style: bold;
    margin-right: 6px;
}

.contents__search {
    flex-grow: 1;
    flex-shrink: 1;
    width: auto;
    min-width: 40px;
    margin: 0;
}

/* ---------- Groups (States, SubStates, Actions, Conditions) ---------- */

.contents-group {
    margin-bottom: 3px;
}

.contents-group > .unity-foldout__toggle {
    margin: 0;
    padding: 2px 0;
    border-radius: 3px;
    background-color: rgba(0, 0, 0, 0.18);
}

.contents-group > .unity-foldout__toggle .unity-label {
    -unity-font-style: bold;
}

/* Stretch the header so the count can sit on the right. */
.contents-group > .unity-foldout__toggle .unity-foldout__input {
    flex-grow: 1;
}

.contents-group__count {
    margin-left: auto;
    margin-right: 6px;
    font-size: 10px;
    color: rgba(150, 150, 150, 1);
    -unity-font-style: normal;
}

.contents-group > .unity-foldout__content {
    margin-left: 10px;
}

.contents-folder-icon {
    width: 14px;
    height: 14px;
    margin-right: 3px;
}

.contents-empty {
    padding: 2px 4px 4px 4px;
    font-size: 10px;
    white-space: normal;
    color: rgba(140, 140, 140, 1);
    -unity-font-style: italic;
}

.contents-drop-target {
    background-color: rgba(77, 153, 255, 0.35);
}

/* ---------- Rows ---------- */

.contents-row {
    flex-direction: row;
    align-items: center;
    height: 20px;
    padding: 0 4px 0 2px;
    border-radius: 3px;
}

.contents-row:hover {
    background-color: rgba(255, 255, 255, 0.06);
}

.contents-row--selected,
.contents-row--selected:hover {
    background-color: rgba(44, 93, 135, 1);
}

.contents-row__mark {
    width: 12px;
    margin-right: 2px;
    font-size: 9px;
    -unity-text-align: middle-center;
}

.contents-row__icon {
    width: 16px;
    height: 16px;
    flex-shrink: 0;
    margin-right: 4px;
}

.contents-row__name {
    flex-grow: 1;
    flex-shrink: 1;
    margin: 0;
    padding: 0;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
}

.contents-row__hint {
    margin-left: 6px;
    font-size: 10px;
    color: rgba(140, 140, 140, 1);
}

.contents-row__field {
    flex-grow: 1;
    margin: 0;
}

/* ● inside this file: default colors. ◆ a shared file. ○ nothing uses it. */
.contents-row--shared .contents-row__mark,
.contents-row--shared .contents-row__name {
    color: rgba(140, 190, 255, 1);
}

.contents-row--unused .contents-row__mark,
.contents-row--unused .contents-row__name {
    color: rgba(150, 150, 150, 1);
    -unity-font-style: italic;
}

/* ---------- From Base (a variant table's Base) ---------- */
/* Lavender, so the Base's things never look like this table's own (default) or a shared file (blue). */

.contents-group--base > .unity-foldout__toggle {
    background-color: rgba(150, 110, 230, 0.28);
}

.contents-group--base > .unity-foldout__toggle .unity-label {
    color: rgba(205, 185, 255, 1);
}

.contents-row--from-base .contents-row__mark,
.contents-row--from-base .contents-row__name {
    color: rgba(190, 165, 255, 1);
}

/* ---------- Inside a sub-state machine / exit state ---------- */

.contents-fold-arrow {
    width: 12px;
    font-size: 8px;
    color: rgba(160, 160, 160, 1);
    -unity-text-align: middle-center;
}

.contents-children {
    padding-left: 14px;
}

.contents-heading {
    flex-direction: row;
    align-items: center;
    height: 16px;
    margin-top: 4px;
    margin-bottom: 1px;
}

.contents-heading__label {
    font-size: 9px;
    color: rgba(140, 140, 140, 1);
    -unity-font-style: bold;
}

.contents-add-button {
    width: 16px;
    height: 14px;
    margin: 0 0 0 4px;
    padding: 0;
    font-size: 11px;
    border-radius: 3px;
}
